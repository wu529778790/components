{
  "name": "@wu529778790/floating-ad",
  "version": "0.1.2",
  "description": "A minimal, zero-dependency floating ad slot widget for any website: image or text ads on the left/right edge, closable, themeable via CSS variables.",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/floating-ad.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "floating",
    "widget",
    "ad",
    "ads",
    "adslot",
    "banner",
    "promotion",
    "sponsor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wu529778790/components.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/floating-ad.css')\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
