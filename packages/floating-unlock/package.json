{
  "name": "@wu529778790/floating-unlock",
  "version": "0.1.0",
  "description": "A minimal, zero-dependency unlock modal that forces users to watch a rewarded video ad (via WeChat mini-program) before continuing their business.",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/floating-unlock.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "modal",
    "popup",
    "dialog",
    "unlock",
    "reward",
    "ad",
    "qrcode",
    "wechat",
    "miniprogram"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wu529778790/components.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/floating-unlock.css')\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}