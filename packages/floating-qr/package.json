{
  "name": "@wu529778790/floating-qr",
  "version": "0.1.5",
  "description": "A minimal, zero-dependency floating widget to showcase WeChat official account QR and donation QR codes on any website.",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/floating-qr.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "floating",
    "widget",
    "qrcode",
    "wechat",
    "donate",
    "sponsor",
    "dianzan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wu529778790/components.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/floating-qr.css')\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
